{
  "realm": "shared",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "collectra-test",
      "name": "Collectra contract test machine client (not production web BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [{
        "name": "collectra-api-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.custom.audience": "collectra-api",
          "access.token.claim": "true",
          "id.token.claim": "false"
        }
      }]
    },
    {
      "clientId": "app-b-test",
      "name": "App B contract test machine client (not production web BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [{
        "name": "app-b-api-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.custom.audience": "app-b-api",
          "access.token.claim": "true",
          "id.token.claim": "false"
        }
      }]
    }
  ]
}
